{
    "version": 6,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 23,
      "patch": 0
    },
    "configurePresets": [
      {
        "name": "xe4",
        "displayName": "Default configure preset for Xe4 workloads",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build",
        "installDir": "${sourceDir}/build/install",
        "cacheVariables": {
          "CMAKE_C_COMPILER": "$env{DPCPP_CC}",
          "CMAKE_CXX_COMPILER": "$env{DPCPP_CXX}",
          "CUTLASS_ENABLE_SYCL": "ON",
          "CUTLASS_ENABLE_BENCHMARKS": "OFF",
          "CUTLASS_ENABLE_GTEST_UNIT_TESTS": "OFF",
          "DPCPP_SYCL_TARGET": "intel_gpu_xe4"
        },
        "environment": {
          "ONEAPI_ROOT": "/opt/intel/oneapi",
          "TBB_ROOT": "$env{ONEAPI_ROOT}/tbb/latest",
          "MKLROOT": "$env{ONEAPI_ROOT}/mkl/latest",
          "DNNL_ROOT": "$env{ONEAPI_ROOT}/dnnl/latest",
          "IntelSYCL_DIR": "$env{DPCPP_ROOT}/lib/cmake",
          "PATH": "$env{IGC20_ROOT}/bin:$penv{PATH}",
          "LD_LIBRARY_PATH": "$env{DPCPP_LD_LIBRARY_PATH}:$env{TBB_ROOT}/lib:$env{DNNL_ROOT}/lib:$penv{LD_LIBRARY_PATH}"
        }
      }
    ],
    "buildPresets": [
      {
        "name": "xe4",
        "displayName": "Default build preset for Xe4 workloads",
        "configurePreset": "xe4",
        "nativeToolOptions": [
          "-j16"
        ]
      }
    ],
    "testPresets": [
      {
        "hidden": true,
        "name": "xe4",
        "configurePreset": "xe4",
        "execution": {
          "jobs": 8,
          "noTestsAction": "error",
          "stopOnFailure": false
        },
        "output" : {
          "verbosity": "verbose",
          "outputOnFailure": true
        },
        "environment": {
          "XE4_LOG_ON": "0",
          "XE4_LOG_FOLDER_PATH": "./logdump",
          "IGC20_ROOT": "/root/llc",
          "L0SIM_DEVICE_KIND": "Xe4",
          "L0SIM_GRITS_PATH": "/root/XE3P_V2",
          "ZESIM_ROOT": "/root/zesim/debug/zesim",
          "ONEAPI_ROOT": "/opt/intel/oneapi",
          "TBB_ROOT": "$env{ONEAPI_ROOT}/tbb/latest",
          "DNNL_ROOT": "$env{ONEAPI_ROOT}/dnnl/latest",
          "OCL_ICD_FILENAMES": "$env{DPCPP_ROOT}/lib/libintelocl.so:$penv{OCL_ICD_FILENAMES}",
          "LD_LIBRARY_PATH": "/root/umf:$env{ZESIM_ROOT}:$env{DPCPP_LD_LIBRARY_PATH}:$env{TBB_ROOT}/lib:$env{DNNL_ROOT}/lib:$penv{LD_LIBRARY_PATH}"
        }
      },
      {
        "name": "xesim",
        "displayName": "Run All Tests on XeSim",
        "inherits": "xe4",
        "environment": {
          "L0SIM_SELECT_DEVICES": "GRITS",
          "L0SIM_GRITS_DEVICE": ":devices/xe4hpc.1tx1x1x4x4.a0.map.xml",
          "L0SIM_GRITS_GRITS_OPTS": "-enablefeature controlFlowAndDispatchSystolic",
          "L0SIM_GRITS_AUBLOAD_OPTS": "-frametime 0 -msglevel verbose -attr EU.Debug false -attr EU.CmdDasm true -attr GT_LSC_L1_NUM_WAYS 180 -sim_mode perf_mfu "
        }
      },
      {
        "name": "debug_xesim",
        "displayName": "Run on XeSim in debug mode",
        "inherits": "xesim",
        "environment": {
          "L0SIM_GRITS_AUBLOAD_OPTS": "-frametime 0 -msglevel verbose -dtrace -attr EU.Debug true -attr EU.CmdDasm true -attr GT_LSC_L1_NUM_WAYS 180 -sim_mode perf_mfu "
        }
      },
      {
        "name": "genisa",
        "displayName": "Run All Tests on GenISA",
        "inherits": "xe4",
        "environment": {
          "L0SIM_SELECT_DEVICES": "XE4ISAI"
        }
      },
      {
        "name": "debug_genisa",
        "displayName": "Run on GenISA in debug mode",
        "inherits": "genisa",
        "environment": {
          "XE4_LOG_ON": "1"
        }
      }
    ]
  }