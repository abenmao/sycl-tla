# Case B: m=1*256*4=1024    n=2*256=512  k=8*64=512
CriGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_256_256_64 --bm_name=double_buffer_sanity --n=512  --k=512  --m=1024  --num_experts=4  --verify=true

