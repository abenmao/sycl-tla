# Double-buffer kernel sanity test.
# All active tiles x all dtypes x two shapes:
#   Case A: 4m-tiles x 2n-tiles x 4k-tiles, 20 experts  (mn_per_expert=8, even)
#   Case B: 1m-tile  x 2n-tiles x 8k-tiles,  4 experts  (mn_per_expert=2, even)

# ---- BF16 (tiles 256x256x32, 32x128x32, 224x256x32) ----
# TileShape 256x256x32
# Case A: m=4*256*20=20480  n=2*256=512  k=4*32=128
CriGroupedGemmDoubleBufferBF16BF16BF16_RRR_TileShape_256_256_32 --bm_name=double_buffer_sanity --n=512  --k=128  --m=20480 --num_experts=20 --verify=true
# Case B: m=1*256*4=1024    n=2*256=512  k=8*32=256
CriGroupedGemmDoubleBufferBF16BF16BF16_RRR_TileShape_256_256_32 --bm_name=double_buffer_sanity --n=512  --k=256  --m=1024  --num_experts=4  --verify=true

# TileShape 32x128x32
# Case A: m=4*32*20=2560    n=2*128=256  k=4*32=128
CriGroupedGemmDoubleBufferBF16BF16BF16_RRR_TileShape_32_128_32  --bm_name=double_buffer_sanity --n=256  --k=128  --m=2560  --num_experts=20 --verify=true
# Case B: m=1*32*4=128      n=2*128=256  k=8*32=256
CriGroupedGemmDoubleBufferBF16BF16BF16_RRR_TileShape_32_128_32  --bm_name=double_buffer_sanity --n=256  --k=256  --m=128   --num_experts=4  --verify=true

# TileShape 224x256x32
# Case A: m=4*224*20=17920  n=2*256=512  k=4*32=128
CriGroupedGemmDoubleBufferBF16BF16BF16_RRR_TileShape_224_256_32 --bm_name=double_buffer_sanity --n=512  --k=128  --m=17920 --num_experts=20 --verify=true
# Case B: m=1*224*4=896     n=2*256=512  k=8*32=256
CriGroupedGemmDoubleBufferBF16BF16BF16_RRR_TileShape_224_256_32 --bm_name=double_buffer_sanity --n=512  --k=256  --m=896   --num_experts=4  --verify=true

# ---- FP8 Tensor (tiles 256x256x64, 192x256x64, 192x320x64, 224x256x64, 288x256x64) ----
