# Smoke test for benchmark_full.in tiles — one shape per tile, verify=true.
# Double-buffer: M=1*tile_m, N=tile_n, K=1*tile_k, 1 expert.
# Regular single-buffer: same convention.

# ---- Regular single-buffer ----

# TileShape 384x320 (SG_8x4)
CriGroupedGemm_E4M3E4M3BF16_RRR_TileShape_384_320_64              --bm_name=benchmark_full_smoke --n=320 --k=64  --m=384 --num_experts=1 --verify=true
CriBLockScalingGroupedGemm_E4M3E4M3BF16_RRR_TileShape_384_320_64  --bm_name=benchmark_full_smoke --n=320 --k=64  --m=384 --num_experts=1 --verify=true
CriBLockScalingGroupedGemm_E2M1E2M1BF16_RCR_TileShape_384_320_128 --bm_name=benchmark_full_smoke --n=320 --k=128 --m=384 --num_experts=1 --verify=true

# TileShape 192x512 (SG_4x8)
CriGroupedGemm_E4M3E4M3BF16_RRR_TileShape_192_512_64              --bm_name=benchmark_full_smoke --n=512 --k=64  --m=192 --num_experts=1 --verify=true
CriBLockScalingGroupedGemm_E4M3E4M3BF16_RRR_TileShape_192_512_64  --bm_name=benchmark_full_smoke --n=512 --k=64  --m=192 --num_experts=1 --verify=true
CriBLockScalingGroupedGemm_E2M1E2M1BF16_RCR_TileShape_192_512_128 --bm_name=benchmark_full_smoke --n=512 --k=128 --m=192 --num_experts=1 --verify=true

