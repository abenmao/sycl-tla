# MoE grouped-GEMM benchmark shapes — CRI / Xe3p (reference src0 + src1 configs)
#
# Per line: <dtype> --bm_name --ep_size --num_experts --topk --hidden_size
#           --new_hidden_size --num_of_tokens --override_number_experts --verify
#
# What the benched GEMM actually is (see MoEBenchmarkOptions::build_rows):
#   M_per_expert = (num_of_tokens * topk / ep_size) / (num_experts / ep_size)
#                == num_of_tokens * topk / num_experts   (ep_size cancels)
#   groups       = override_number_experts        <- replaces the routing count
#   K, N         = hidden_size, new_hidden_size   (proj=up; down swaps them)
fp8_tensor_moe --bm_name=bm_src0 --ep_size=1 --num_experts=24 --topk=1 --hidden_size=128 --new_hidden_size=3584 --num_of_tokens=16392 --override_number_experts=16 --verify=host
fp8_tensor_moe --bm_name=bm_src0 --ep_size=1 --num_experts=24 --topk=1 --hidden_size=128 --new_hidden_size=3584 --num_of_tokens=32784 --override_number_experts=16 --verify=host
