# Failing cases from double_buffer_sanity: 192x256 and 192x320 tiles,
# Case A (20 experts, uniform_m=768) which fails; Case B (4 experts) also included.

# TileShape 192x256x64 — FP8 Tensor
# Case A: m=4*192*20=15360  n=2*256=512  k=4*64=256
CriGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_192_256_64 --bm_name=double_buffer_failing --n=512  --k=256  --m=15360 --num_experts=20 --verify=true
# Case B: m=1*192*4=768     n=2*256=512  k=8*64=512
CriGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_192_256_64 --bm_name=double_buffer_failing --n=512  --k=512  --m=768   --num_experts=4  --verify=true

# TileShape 192x256x64 — MxFP8
# Case A
CriBLockScalingGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_192_256_64 --bm_name=double_buffer_failing --n=512  --k=256  --m=15360 --num_experts=20 --verify=true
# Case B
CriBLockScalingGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_192_256_64 --bm_name=double_buffer_failing --n=512  --k=512  --m=768   --num_experts=4  --verify=true

# TileShape 192x320x64 — FP8 Tensor
# Case A: m=4*192*20=15360  n=2*320=640  k=4*64=256
CriGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_192_320_64 --bm_name=double_buffer_failing --n=640  --k=256  --m=15360 --num_experts=20 --verify=true
# Case B: m=1*192*4=768     n=2*320=640  k=8*64=512
CriGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_192_320_64 --bm_name=double_buffer_failing --n=640  --k=512  --m=768   --num_experts=4  --verify=true

# TileShape 192x320x64 — MxFP8
# Case A
CriBLockScalingGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_192_320_64 --bm_name=double_buffer_failing --n=640  --k=256  --m=15360 --num_experts=20 --verify=true
# Case B
CriBLockScalingGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_192_320_64 --bm_name=double_buffer_failing --n=640  --k=512  --m=768   --num_experts=4  --verify=true
