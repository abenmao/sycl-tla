# MoE FULL benchmark, TAIL-REBALANCED — CRI / Xe3p.
# Same shapes as benchmark_full.in with '_moe' dtype tags (MoE path).
#
# Rebalance: the all-expert test has ~no tail but can't run, so override_number_experts
# is retuned per line (shape + per-expert M unchanged, even E in [2, experts_per_gpu]):
#   - smallest even E with >=7 waves and tail==0, if <=80 waves; else the even E with
#     waves closest to 80 (biggest in-budget test => smallest tail weight).
#
# Per line: <dtype> --bm_name --ep_size --num_experts --topk --hidden_size
#           --new_hidden_size --num_of_tokens --override_number_experts --verify
#   M_per_expert = num_of_tokens*topk/(num_experts/ep_size); groups = override_number_experts.
# Scheduling is dtype-independent: src0 -> fp8_tensor/mxfp8/mxfp4, src1 -> bf16.
# Annotation: # ovr A->B | waves W1->W2 | tail T1->T2 | waste w1->w2 | Mpe=.. cap=.. [rule]
fp8_tensor_moe --bm_name=bm_src0 --ep_size=1 --num_experts=24 --topk=1 --hidden_size=1280 --new_hidden_size=3584 --num_of_tokens=16392 --override_number_experts=24 --verify=host  # ovr 16->24 | waves 11->16 | tail 16->24 | waste 5%->2% | Mpe=683 cap=24 [~80w:min-tail-weight]
fp8_tensor_moe --bm_name=bm_src0 --ep_size=1 --num_experts=24 --topk=1 --hidden_size=1280 --new_hidden_size=3584 --num_of_tokens=32784 --override_number_experts=16 --verify=host  # kept 16 | waves 21->21 | tail 0->0 | waste 0%->0% | Mpe=1366 cap=24 [tail0<=80w]
fp8_tensor_moe --bm_name=bm_src0 --ep_size=1 --num_experts=24 --topk=1 --hidden_size=1280 --new_hidden_size=3584 --num_of_tokens=61440 --override_number_experts=16 --verify=host  # ovr 8->16 | waves 18->35 | tail 16->0 | waste 3%->0% | Mpe=2560 cap=24 [tail0<=80w]
fp8_tensor_moe --bm_name=bm_src0 --ep_size=1 --num_experts=24 --topk=1 --hidden_size=1280 --new_hidden_size=3584 --num_of_tokens=65544 --override_number_experts=24 --verify=host  # ovr 10->24 | waves 25->58 | tail 2->24 | waste 4%->0% | Mpe=2731 cap=24 [~80w:min-tail-weight]
fp8_tensor_moe --bm_name=bm_src0 --ep_size=1 --num_experts=24 --topk=1 --hidden_size=1280 --new_hidden_size=3584 --num_of_tokens=131088 --override_number_experts=16 --verify=host  # ovr 6->16 | waves 29->77 | tail 28->0 | waste 0%->0% | Mpe=5462 cap=24 [tail0<=80w]
