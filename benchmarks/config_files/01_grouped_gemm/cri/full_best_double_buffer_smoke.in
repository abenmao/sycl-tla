CriBLockScalingGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_288_256_64  --bm_name=src_0_best_double_buffer_smoke --n=256 --k=64  --m=576 --num_experts=1 --verify=true
CriBLockScalingGroupedGemmDoubleBuffer_E2M1E2M1BF16_RCR_TileShape_288_256_128 --bm_name=src_0_best_double_buffer_smoke --n=256 --k=128 --m=576 --num_experts=1 --verify=true

