# Smoke test: M=tile_m*2, N=tile_n, K=tile_k, 1 expert — one launch per (dtype, tile shape).
# mxfp4 K-tile is 128; fp8-tensor and mxfp8 K-tile is 64; bf16 K-tile is 32.

# TileShape 256x256
CriGroupedGemmDoubleBufferBF16BF16BF16_RRR_TileShape_256_256_32               --bm_name=src_1_best_double_buffer_smoke --n=256 --k=32  --m=512 --num_experts=1 --verify=true
CriGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_256_256_64              --bm_name=src_0_best_double_buffer_smoke --n=256 --k=64  --m=512 --num_experts=1 --verify=true
CriBLockScalingGroupedGemmDoubleBuffer_E4M3E4M3BF16_RRR_TileShape_256_256_64  --bm_name=src_0_best_double_buffer_smoke --n=256 --k=64  --m=512 --num_experts=1 --verify=true
CriBLockScalingGroupedGemmDoubleBuffer_E2M1E2M1BF16_RCR_TileShape_256_256_128 --bm_name=src_0_best_double_buffer_smoke --n=256 --k=128 --m=512 --num_experts=1 --verify=true

# TileShape 288x256
