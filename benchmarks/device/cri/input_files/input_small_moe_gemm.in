#############################################################################
### MoE GEMM benchmark (aligned with example 12_xe20_moe_gemm_cute_interface) ###
#############################################################################
#
# Maps grouped-gemm options onto a MoE problem:
#   --groups -> number of experts
#   --m      -> tokens routed to each expert (uniform distribution)
#   --n/--k  -> MoE GEMM N / K extents
# Config: PersistentTileSchedulerXeMoE + TileShape <256, 128, 32>, bf16 in/out.
# Note: GroupedGEMMOptions requires --groups > 2.

# small shapes kept active for the CRI simulator
CriMoEGemmBF16BF16BF16_RRR_TileShape_256_128_32 --bm_name=cri_moe_mm --groups=8 --m=256 --n=256 --k=256
CriMoEGemmBF16BF16BF16_RRR_TileShape_256_128_32 --bm_name=cri_moe_mm --groups=8 --m=512 --n=512 --k=512

# example-aligned gpt-oss-20b prefill shapes (n=2880/5760, k=2880), disabled for CRI as time-consuming
# CriMoEGemmBF16BF16BF16_RRR_TileShape_256_128_32 --bm_name=cri_moe_mm --groups=32 --m=256 --n=2880 --k=2880
# CriMoEGemmBF16BF16BF16_RRR_TileShape_256_128_32 --bm_name=cri_moe_mm --groups=32 --m=256 --n=5760 --k=2880
